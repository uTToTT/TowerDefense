    - target: {fileID: 1839969085653440539, guid: 6fa4be41aa7f59c44b46b30dfdb86728, type: 3}
      propertyPath: m_text
      value: "- \u041A\u043E\u043C\u0430\u043D\u0434\u0438\u0440\u0435, \u043D\u0430\u0448
        \u0430\u0440\u0441\u0435\u043D\u0430\u043B \u043F\u043E\u043F\u043E\u0432\u043D\u044E\u0454\u0442\u044C\u0441\u044F
        \u043D\u043E\u0432\u0438\u043C\u0438 \u0432\u0435\u0436\u0430\u043C\u0438.
        \u0412\u0447\u0435\u043D\u0456 \u0440\u043E\u0437\u0440\u043E\u0431\u0438\u043B\u0438
        \u043C\u043E\u0434\u0435\u0440\u043D\u0456\u0437\u0430\u0446\u0456\u044E
        \u0434\u043B\u044F \"\u0422\u0432\u0456\u043D\", \u0449\u043E \u0434\u043E\u0437\u0432\u043E\u043B\u044F\u0454
        \u0441\u0442\u0440\u0456\u043B\u044F\u0442\u0438 \u043E\u0434\u0440\u0430\u0437\u0443
        \u0434\u0432\u043E\u043C\u0430 \u0441\u043D\u0430\u0440\u044F\u0434\u0430\u043C\u0438.
        \u0426\u0435 \u0434\u043E\u043F\u043E\u043C\u043E\u0436\u0435 \u043D\u0430\u043C
        \u0431\u0456\u043B\u044C\u0448 \u0435\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E
        \u0437\u043D\u0438\u0449\u0443\u0432\u0430\u0442\u0438 \u043C\u0430\u043B\u043E\u0437\u0430\u0445\u0438\u0449\u0435\u043D\u043D\u0438\u0445
        \u0432\u043E\u0440\u043E\u0433\u0456\u0432"
      objectReference: {fileID: 0}
    - target: {fileID: 2255444081324880424, guid: 6fa4be41aa7f59c44b46b30dfdb86728, type: 3}
      propertyPath: m_text
