    - target: {fileID: 1669299300235286155, guid: 6fa4be41aa7f59c44b46b30dfdb86728, type: 3}
      propertyPath: m_text
      value: "\u0433\u0440\u0430\u0432\u0456\u0442\u0456-T1"
      objectReference: {fileID: 0}
    - target: {fileID: 1839969085653440539, guid: 6fa4be41aa7f59c44b46b30dfdb86728, type: 3}
      propertyPath: m_text
      value: "- \u041A\u043E\u043C\u0430\u043D\u0434\u0438\u0440\u0435, \u0432\u043E\u0440\u043E\u0433
        \u043C\u0430\u0454 \u043F\u0435\u0440\u0435\u0432\u0430\u0433\u0443 \u0443
        \u0447\u0438\u0441\u043B\u0456, \u0447\u0435\u0440\u0435\u0437 \u0446\u0435
        \u043D\u0430\u043C \u0431\u0440\u0430\u043A\u0443\u0454 \u0432\u043E\u0433\u043D\u0435\u0432\u043E\u0457
        \u0441\u0438\u043B\u0438. \u0412\u0447\u0435\u043D\u0456 \u0440\u043E\u0437\u0440\u043E\u0431\u0438\u043B\u0438
        \"\u0413\u0440\u0430\u0432\u0456\u0442\u0456\", \u0432\u043E\u043D\u0430
        \u0434\u043E\u043F\u043E\u043C\u043E\u0436\u0435 \u043D\u0430\u043C \u0441\u043F\u043E\u0432\u0456\u043B\u044C\u043D\u0438\u0442\u0438
        \u0432\u043E\u0440\u043E\u0433\u0430.\n\"\u0413\u0440\u0430\u0432\u0456\u0442\u0456\"
        - \u0435\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0438\u0439 \u0434\u043B\u044F
        \u0441\u043F\u043E\u0432\u0456\u043B\u044C\u043D\u0435\u043D\u044F \u0432\u043E\u0440\u043E\u0433\u0430."
      objectReference: {fileID: 0}
