  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\"\u0413\u0440\u0430\u0432\u0456\u0442\u0456\" \u0435\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E
    \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438
    \u043F\u043E\u0440\u0443\u0447 \u0437 \u0456\u043D\u0448\u0438\u043C\u0438 \u0432\u0435\u0436\u0430\u043C\u0438,
    \u0449\u043E\u0431 \u043D\u0430\u043D\u0435\u0441\u0442\u0438 \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u0443
    \u0448\u043A\u043E\u0434\u0443.  \r\n\r\n\u041D\u0430\u043F\u0440\u0438\u043A\u043B\u0430\u0434,
    \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u0438 \"\u0413\u0440\u0430\u0432\u0456\u0442\u0456\"
    \u0442\u0430 \u043F\u043E\u0440\u0443\u0447 \u0434\u0435\u043A\u0456\u043B\u044C\u043A\u0430
    \"\u041C\u0456\u043D\u0456\u0433\u0430\u043D\u0456\u0432\" \u0456 \u0442\u0440\u043E\u0445\u0438
    \u0434\u0430\u043B\u0456 \u0434\u0435\u043A\u0456\u043B\u044C\u043A\u0430 \"\u0422\u0432\u0456\u043D\u0456\u0432\". 
    \r\n\r\n\"\u0413\u0440\u0430\u0432\u0456\u0442\u0456\" - \u0441\u043F\u043E\u0432\u0456\u043B\u044C\u043D\u044E\u0454.
    \r\n\"\u041C\u0456\u043D\u0456\u0433\u0430\u043D\" - \u043F\u043E\u0442\u0440\u043E\u0445\u0438
    \u043D\u0430\u043D\u043E\u0441\u0438\u0442\u044C \u0448\u043A\u043E\u0434\u0443.
    \r\n\"\u0422\u0432\u0456\u043D\" - \u0434\u043E\u0431\u0438\u0432\u0430\u0454
    \u0446\u0456\u043B\u044C "
