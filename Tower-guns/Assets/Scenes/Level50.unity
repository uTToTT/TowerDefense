  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0417\u0430 \u043D\u0430\u044F\u0432\u043D\u0456\u0441\u0442\u044E 70+
    \u0437\u0456\u0440\u043E\u043A, \u0446\u0435\u0439 \u0440\u0456\u0432\u0435\u043D\u044C
    \u0431\u0443\u0434\u0435 \u043F\u0440\u043E\u0441\u0442\u0456\u0448\u0435 \u043F\u0440\u043E\u0439\u0442\u0438. 
    \r\n\r\n\"2\u0445 \u0437 \u043F\u0440\u043E\u0434\u0430\u0436\u0443 \u0432\u0435\u0436\"
    \u0434\u043E\u0437\u0432\u043E\u043B\u044F\u0454 \u043F\u0440\u043E\u0434\u0430\u0432\u0430\u0442\u0438
    \u0432\u0435\u0436\u0456 \u043F\u0435\u0440\u0448\u043E\u0433\u043E \u0440\u0456\u0432\u043D\u044F
    \u043F\u043E \u0446\u0456\u043D\u0456 \u0457\u0445 \u043F\u043E\u0431\u0443\u0434\u043E\u0432\u0438. 
    \r\n\r\n\u041F\u0440\u043E \u0456\u043D\u0448\u0456 \u0431\u043E\u043D\u0443\u0441\u0438
    \u0437\u0430 \u0437\u0456\u0440\u043A\u0438 \u043C\u043E\u0436\u043D\u0430 \u0434\u0456\u0437\u043D\u0430\u0442\u0438\u0441\u044C
    \u0443 \u0433\u043E\u043B\u043E\u0432\u043D\u043E\u043C\u0443 \u043C\u0435\u043D\u044E."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 6665b8cfb2847ee40ac1ce8c419b33ae, type: 2}
