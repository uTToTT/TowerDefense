--- !u!114 &1583124261
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1583124259}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6ff121ac433050040bbc3afdb0155ef0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _language: 0
  _text:
  - "- \u041A\u043E\u043C\u0430\u043D\u0434\u0438\u0440\u0435, \u0432\u043E\u0440\u043E\u0433\u0430
    \u0441\u0442\u0430\u0454 \u0434\u0435\u0434\u0430\u043B\u0456 \u0431\u0456\u043B\u044C\u0448\u0435.
    \"\u041C\u0456\u043D\u0456\u0433\u0430\u043D\u0430\u043C\" \u0432\u0436\u0435
    \u043D\u0435 \u0432\u0434\u0430\u0454\u0442\u044C\u0441\u044F \u0457\u0445 \u0441\u0442\u0440\u0438\u043C\u0443\u0432\u0430\u0442\u0438.
    \u0429\u043E\u0431 \u0432\u0438\u0440\u0456\u0448\u0438\u0442\u0438 \u0446\u044E
    \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0443, \u0432\u0447\u0435\u043D\u0456 
    \u0441\u0442\u0432\u043E\u0440\u0438\u043B\u0438 \u043D\u043E\u0432\u0443 \u043C\u043E\u0434\u0435\u043B\u044C
    \u043A\u0443\u043B\u0435\u043C\u0435\u0442\u0443. \u0422\u0435\u043F\u0435\u0440
    \"\u041C\u0456\u043D\u0456\u0433\u0430\u043D\" \u043C\u043E\u0436\u043D\u0430
    \u043C\u043E\u0434\u0435\u0440\u043D\u0456\u0437\u0443\u0432\u0430\u0442\u0438
    \u0434\u043E \"\u0412\u0438\u0431\u0443\u0445\u043E\u0432\u0438\u0439 \u043C\u0456\u043D\u0456\u0433\u0430\u043D\".  "
  - '- Captain, the enemy is growing in numbers. The "Miniguns" are no longer able
    to hold them back. To address this problem, our scientists have developed a new
    model of the machine gun. Now, the "Minigun" can be upgraded to the "Explosive
    Minigun."'
  _updateInEditor: 0
