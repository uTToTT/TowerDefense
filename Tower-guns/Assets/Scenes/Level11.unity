    - target: {fileID: 8641446298700812738, guid: adec6a6ac01c1934a8d9d384827f7420, type: 3}
      propertyPath: m_text
      value: "- \u041A\u043E\u043C\u0430\u043D\u0434\u0438\u0440\u0435, \u0432\u043E\u0440\u043E\u0433\u0430
        \u0441\u0442\u0430\u0454 \u0434\u0435\u0434\u0430\u043B\u0456 \u0431\u0456\u043B\u044C\u0448\u0435.
        \"\u041C\u0456\u043D\u0456\u0433\u0430\u043D\u0430\u043C\" \u0432\u0436\u0435
        \u043D\u0435 \u0432\u0434\u0430\u0454\u0442\u044C\u0441\u044F \u0457\u0445
        \u0441\u0442\u0440\u0438\u043C\u0443\u0432\u0430\u0442\u0438. \u0429\u043E\u0431
        \u0432\u0438\u0440\u0456\u0448\u0438\u0442\u0438 \u0446\u044E \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0443,
        \u0432\u0447\u0435\u043D\u0456  \u0441\u0442\u0432\u043E\u0440\u0438\u043B\u0438
        \u043D\u043E\u0432\u0443 \u043C\u043E\u0434\u0435\u043B\u044C \u043A\u0443\u043B\u0435\u043C\u0435\u0442\u0443.
        \u0422\u0435\u043F\u0435\u0440 \"\u041C\u0456\u043D\u0456\u0433\u0430\u043D\"
        \u043C\u043E\u0436\u043D\u0430 \u043C\u043E\u0434\u0435\u0440\u043D\u0456\u0437\u0443\u0432\u0430\u0442\u0438
        \u0434\u043E \"\u0412\u0438\u0431\u0443\u0445\u043E\u0432\u0438\u0439 \u043C\u0456\u043D\u0456\u0433\u0430\u043D\".  "
