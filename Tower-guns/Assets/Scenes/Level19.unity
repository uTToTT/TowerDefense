--- !u!114 &1602744166
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1602744165}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6ff121ac433050040bbc3afdb0155ef0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _language: 0
  _text:
  - "- \u041A\u043E\u043C\u0430\u043D\u0434\u0438\u0440\u0435, \u0432 \u043D\u0430\u0441
    \u0441\u0442\u0430\u0454 \u0434\u0435\u0434\u0430\u043B\u0456 \u0431\u0456\u043B\u044C\u0448\u0435
    \u043E\u0437\u0431\u0440\u043E\u0454\u043D\u043D\u044F, \u0440\u0430\u0437\u043E\u043C
    \u0437 \u0446\u0438\u043C \u0456 \u0432\u0438\u0442\u0440\u0430\u0442\u0438.
    \u0412\u0447\u0435\u043D\u0456 \u0437\u043D\u0430\u0439\u0448\u043B\u0438 \u0440\u0456\u0448\u0435\u043D\u043D\u044F
    \u0446\u0456\u0454\u0457 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0438. \u0414\u043E\u0434\u0430\u043D\u043E
    \u043C\u043E\u0434\u0438\u0444\u0456\u043A\u0430\u0446\u0456\u044E \u0434\u043B\u044F
    \"\u0433\u0440\u0430\u0432\u0456\u0442\u0456\", \u0449\u043E \u0437\u0431\u0456\u043B\u044C\u0448\u0443\u0454
    \u043A\u0456\u043B\u044C\u043A\u0456\u0441\u0442\u044C \u043E\u0442\u0440\u0438\u043C\u0430\u043D\u0438\u0445
    \u043C\u043E\u043D\u0435\u0442 \u0437 \u0432\u043E\u0440\u043E\u0433\u0430."
  - '- Captain, as our arsenal grows, so do our expenses. The scientists have found
    a solution to this problem. A new modification for "Gravity" has been added,
    which increases the number of coins received from enemies.'
  _updateInEditor: 0
