      m_Calls: []
  m_text: "\"\u041A\u0440\u0435\u0434\u0438\u0442\u043E\u0440\" \u2014 \u0435\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0430
    \u0432\u0435\u0436\u0430 \u043D\u0430 \u043F\u043E\u0447\u0430\u0442\u043A\u0443,
    \u043A\u043E\u043B\u0438 \u043C\u043E\u043D\u0435\u0442 \u043C\u0430\u0439\u0436\u0435
    \u043D\u0435\u043C\u0430\u0454.  \r\n\r\n\u0421\u043B\u0456\u0434 \u0440\u043E\u0437\u043C\u0456\u0449\u0443\u0432\u0430\u0442\u0438
    \u0431\u043B\u0438\u0436\u0447\u0435 \u0434\u043E \u043F\u043E\u0447\u0430\u0442\u043A\u0443
    \u0448\u043B\u044F\u0445\u0443, \u0440\u0430\u0437\u043E\u043C \u0437 \"\u0412\u0438\u0431\u0443\u0445\u043E\u0432\u0438\u043C
    \u043C\u0456\u043D\u0456\u0433\u0430\u043D\u043E\u043C\". \u0422\u0430\u043A\u043E\u0436
    \u0431\u0443\u0434\u0435 \u043A\u043E\u0440\u0438\u0441\u043D\u0438\u043C \u0434\u043E\u0434\u0430\u0442\u0438
    \"\u041C\u043E\u0440\u043E\u0437\u043D\u0438\u0439 \u043C\u0456\u043D\u0456\u0433\u0430\u043D\",
    \u0449\u043E\u0431 \u044F\u043A\u043E\u043C\u043E\u0433\u0430 \u0434\u043E\u0432\u0448\u0435
    \u0437\u0430\u0442\u0440\u0438\u043C\u0430\u0442\u0438 \u0432\u043E\u0440\u043E\u0433\u0456\u0432
    \u0443 \u0440\u0430\u0434\u0456\u0443\u0441\u0456 \"\u041A\u0440\u0435\u0434\u0438\u0442\u043E\u0440\u0430\"."
