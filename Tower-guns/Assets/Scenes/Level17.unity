    - target: {fileID: 1669299300235286155, guid: 6fa4be41aa7f59c44b46b30dfdb86728, type: 3}
      propertyPath: m_text
      value: "\u0442\u0432\u0456\u043D\n\u0448\u0430\u0440\u0434-T3"
      objectReference: {fileID: 0}
    - target: {fileID: 1839969085653440539, guid: 6fa4be41aa7f59c44b46b30dfdb86728, type: 3}
      propertyPath: m_text
      value: "- \u041A\u043E\u043C\u0430\u043D\u0434\u0438\u0440\u0435, \u0432\u043E\u0440\u043E\u0433
        \u043F\u043E\u0447\u0430\u0432 \u0437\u0431\u0456\u043B\u044C\u0448\u0443\u0432\u0430\u0442\u0438
        \u043A\u0456\u043B\u044C\u043A\u0456\u0441\u0442\u044C \u043C\u0430\u043B\u043E\u0437\u0430\u0445\u0438\u0449\u0435\u043D\u043D\u0438\u0445
        \u043E\u0434\u0438\u043D\u0438\u0446\u044C. \u0412\u0447\u0435\u043D\u0456
        \u0434\u043E\u0434\u0430\u043B\u0438 \u043A\u043E\u0440\u0435\u043A\u0442\u0438\u0432\u0438
        \u0434\u043E \"\u0422\u0432\u0456\u043D\", \u0442\u0435\u043F\u0435\u0440
        \u0443 \u043D\u043E\u0432\u0456\u0439 \u043C\u043E\u0434\u0438\u0444\u0456\u043A\u0430\u0446\u0456\u0457
        \"\u0422\u0432\u0456\u043D \u0448\u0430\u0440\u0434\" \u0441\u043D\u0430\u0440\u044F\u0434\u0438
        \u0440\u043E\u0437\u0440\u0438\u0432\u0430\u044E\u0442\u044C\u0441\u044F
        \u0442\u0430 \u0443\u043B\u0430\u043C\u043A\u0430\u043C\u0438 \u0443\u0440\u0430\u0436\u0430\u044E\u0442\u044C
        \u043D\u0430\u0441\u0442\u0443\u043F\u043D\u0438\u0445 \u0432\u043E\u0440\u043E\u0433\u0456\u0432."
      objectReference: {fileID: 0}
    - target: {fileID: 2255444081324880424, guid: 6fa4be41aa7f59c44b46b30dfdb86728, type: 3}
      propertyPath: m_text
      value: "\u0428\u043A\u043E\u0434\u0430: 140\n\u0421\u043A\u043E\u0440\u043E\u0441\u0442\u0440\u0456\u043B\u044C\u043D\u0456\u0441\u0442\u044C:
        1.0/\u0441\n\u041F\u0440\u043E\u0431\u0438\u0442\u0442\u044F: 10%\n\u0428\u043A\u043E\u0434\u0430(\u0443\u043B\u0430\u043C\u043E\u043A):
        70\n\u041A\u0456\u043B-\u0441\u0442\u044C \u0443\u043B\u0430\u043C\u043A\u0456\u0432:
        2\n"
