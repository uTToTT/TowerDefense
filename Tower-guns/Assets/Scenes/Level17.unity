--- !u!114 &2060087121
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2060087120}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6ff121ac433050040bbc3afdb0155ef0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _language: 0
  _text:
  - "- \u041A\u043E\u043C\u0430\u043D\u0434\u0438\u0440\u0435, \u0432\u043E\u0440\u043E\u0433
    \u043F\u043E\u0447\u0430\u0432 \u0437\u0431\u0456\u043B\u044C\u0448\u0443\u0432\u0430\u0442\u0438
    \u043A\u0456\u043B\u044C\u043A\u0456\u0441\u0442\u044C \u043C\u0430\u043B\u043E\u0437\u0430\u0445\u0438\u0449\u0435\u043D\u043D\u0438\u0445
    \u043E\u0434\u0438\u043D\u0438\u0446\u044C. \u0412\u0447\u0435\u043D\u0456 \u0434\u043E\u0434\u0430\u043B\u0438
    \u043A\u043E\u0440\u0435\u043A\u0442\u0438\u0432\u0438 \u0434\u043E \"\u0422\u0432\u0456\u043D\",
    \u0442\u0435\u043F\u0435\u0440 \u0443 \u043D\u043E\u0432\u0456\u0439 \u043C\u043E\u0434\u0438\u0444\u0456\u043A\u0430\u0446\u0456\u0457
    \"\u0422\u0432\u0456\u043D \u0448\u0430\u0440\u0434\" \u0441\u043D\u0430\u0440\u044F\u0434\u0438
    \u0440\u043E\u0437\u0440\u0438\u0432\u0430\u044E\u0442\u044C\u0441\u044F \u0442\u0430
    \u0443\u043B\u0430\u043C\u043A\u0430\u043C\u0438 \u0443\u0440\u0430\u0436\u0430\u044E\u0442\u044C
    \u043D\u0430\u0441\u0442\u0443\u043F\u043D\u0438\u0445 \u0432\u043E\u0440\u043E\u0433\u0456\u0432."
  - '- Captain, the enemy has started increasing the number of lightly armored units.
    Our scientists have made adjustments to the "Twin." In the new modification,
    "Twin Shard," the projectiles explode and the shards hit additional enemies.'
  _updateInEditor: 0
