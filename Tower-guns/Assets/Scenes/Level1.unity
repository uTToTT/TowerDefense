  m_Name: 
  m_EditorClassIdentifier: 
  _language: 0
  _text:
  - "\u0417\u0430\u0440\u043E\u0431\u043B\u044F\u0439\u0442\u0435 \u0431\u0456\u043B\u044C\u0448\u0435
    \u0437\u0456\u0440\u043E\u043A. \\n\u0411\u0456\u043B\u044C\u0448\u0435 \u0437\u0456\u0440\u043E\u043A
    - \u0431\u0456\u043B\u044C\u0448\u0435 \u0431\u043E\u043D\u0443\u0441\u0456\u0432.       
    \\n\\n      20 - 20  =         \\n\\n      19 - 10  =           \\n\\n      09
    - 01  =     \\n\\n\u0429\u043E\u0431 \u043F\u0435\u0440\u0435\u0433\u043B\u044F\u043D\u0443\u0442\u0438
    \u0431\u043E\u043D\u0443\u0441\u0438, \u043F\u0435\u0440\u0435\u0439\u0434\u0456\u0442\u044C
    \u0443 \u043C\u0435\u043D\u044E \u0442\u0430 \u043D\u0430\u0442\u0438\u0441\u043D\u0456\u0442\u044C
    \u043D\u0430 \u0437\u0456\u0440\u043A\u0443."
  - Earn more stars. \nMore stars mean more bonuses.  \n\n      20 - 20  =  \n\n     
    19 - 10  =  \n\n      09 - 01  =  \n\nTo view the bonuses, go to the menu and
    click on the star.
  _updateInEditor: 0
