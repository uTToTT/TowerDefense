    - target: {fileID: 1839969085653440539, guid: 6fa4be41aa7f59c44b46b30dfdb86728, type: 3}
      propertyPath: m_text
      value: "- \u041A\u043E\u043C\u0430\u043D\u0434\u0438\u0440\u0435, \u0432\u043E\u0440\u043E\u0433
        \u0441\u0442\u0430\u0454 \u0434\u0435\u0434\u0430\u043B\u0456 \u0432\u0438\u0442\u0440\u0438\u0432\u0430\u043B\u0456\u0448\u0438\u043C
        \u0434\u043B\u044F \u0441\u043D\u0430\u0440\u044F\u0434\u0456\u0432. \u0412
        \u043F\u0440\u043E\u0442\u0438\u0432\u0430\u0433\u0443 \u0446\u044C\u043E\u043C\u0443,
