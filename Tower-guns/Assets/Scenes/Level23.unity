MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2021061339}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6ff121ac433050040bbc3afdb0155ef0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _language: 0
  _text:
  - "\"\u0410\u0441\u0430\u0441\u0438\u043D\" - \u0435\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0438\u0439
    \u043B\u0438\u0448\u0435 \u043F\u0440\u043E\u0442\u0438 \u0431\u0440\u043E\u043D\u044C\u043E\u0432\u0430\u043D\u0438\u0445
    \u0442\u0430 \u0432\u0438\u0442\u0440\u0438\u0432\u0430\u043B\u0438\u0445 \u0432\u043E\u0440\u043E\u0433\u0456\u0432
    \u0437\u0430\u0432\u0434\u044F\u043A\u0438 \u0432\u0438\u0441\u043E\u043A\u043E\u043C\u0443
    \u043F\u0440\u043E\u0431\u0438\u0442\u0442\u044E \u0442\u0430 \u0448\u043A\u043E\u0434\u0456.
    \u041D\u0435 \u0435\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0438\u0439 \u043F\u0440\u043E\u0442\u0438
    \u0432\u0435\u043B\u0438\u043A\u043E\u0457 \u043A\u0456\u043B\u044C\u043A\u043E\u0441\u0442\u0456
    \u0446\u0456\u043B\u0435\u0439.  \\n\\n\u0414\u043E\u0431\u0440\u0435 \u0441\u0438\u043D\u0435\u0440\u0433\u0443\u0454
    \u0437 \"\u0412\u0438\u0441\u043D\u0430\u0436\u0443\u0432\u0430\u0447\u0435\u043C\". "
  - ' "Assassin" is effective only against armored and resilient enemies due to its
    high piercing and damage. It is not effective against large numbers of targets. 
    \n\nIt works well in synergy with "Drainer."'
  _updateInEditor: 1
