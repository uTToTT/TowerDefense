    - target: {fileID: 1669299300235286155, guid: 6fa4be41aa7f59c44b46b30dfdb86728, type: 3}
      propertyPath: m_text
      value: "\u0440\u0435\u0439\u043B-T1"
      objectReference: {fileID: 0}
    - target: {fileID: 1839969085653440539, guid: 6fa4be41aa7f59c44b46b30dfdb86728, type: 3}
      propertyPath: m_text
      value: "- \u041A\u043E\u043C\u0430\u043D\u0434\u0438\u0440\u0435, \u0437\u0430
        \u0434\u0430\u043D\u0438\u043C\u0438 \u0440\u043E\u0437\u0432\u0456\u0434\u043A\u0438,
        \u0432\u043E\u0440\u043E\u0433 \u0441\u0442\u0430\u0454 \u0441\u0438\u043B\u044C\u043D\u0456\u0448\u0438\u043C.
        \u0412\u043E\u043D\u0438 \u043F\u043E\u043A\u0440\u0430\u0449\u0443\u044E\u0442\u044C
        \u0441\u0432\u043E\u044E \u0431\u0440\u043E\u043D\u044E \u0442\u0430 \u0441\u0442\u0430\u044E\u0442\u044C
        \u0431\u0456\u043B\u044C\u0448 \u0432\u0438\u0442\u0440\u0438\u0432\u0430\u043B\u0438\u043C\u0438
        \u0434\u043E \u0441\u043D\u0430\u0440\u044F\u0434\u0456\u0432. \u041D\u0430\u0448\u0456
        \u0432\u0447\u0435\u043D\u0456 \u0437\u043D\u0430\u0439\u0448\u043B\u0438
        \u0446\u044C\u043E\u043C\u0443 \u043F\u0430\u043D\u0430\u0446\u0435\u044E
        - \"\u0420\u0435\u0439\u043B\".\n\"\u0420\u0435\u0439\u043B\" - \u0435\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0438\u0439
        \u043F\u0440\u043E\u0442\u0438 \u0432\u043E\u0440\u043E\u0433\u0456\u0432
        \u0456\u0437 \u0432\u0435\u043B\u0438\u043A\u043E\u044E \u043A\u0456\u043B\u044C\u043A\u0456\u0441\u0442\u044E
        \u0437\u0434\u043E\u0440\u043E\u0432'\u044F \u0442\u0430 \u0442\u043E\u0432\u0441\u0442\u043E\u044E
        \u0431\u0440\u043E\u043D\u0435\u044E."
      objectReference: {fileID: 0}
