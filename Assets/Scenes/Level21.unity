  m_Script: {fileID: 11500000, guid: 6ff121ac433050040bbc3afdb0155ef0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _language: 0
  _text:
  - "- \u041A\u043E\u043C\u0430\u043D\u0434\u0438\u0440\u0435, \u0432\u0447\u0435\u043D\u0456
    \u0441\u0442\u0432\u043E\u0440\u0438\u043B\u0438 \u043D\u043E\u0432\u0438\u0439
    \u043F\u0440\u043E\u0442\u043E\u0442\u0438\u043F \"\u0412\u0438\u0441\u043D\u0430\u0436\u0443\u0432\u0430\u0447\"
    \u043D\u0430 \u043E\u0441\u043D\u043E\u0432\u0456 \"\u0413\u0440\u0430\u0432\u0456\u0442\u0456\".
    \u0423\u0441\u0456 \u0432\u043E\u0440\u043E\u0433\u0438, \u0449\u043E \u0443
    \u0440\u0430\u0434\u0456\u0443\u0441\u0456 \u0434\u0456\u0457, \u0431\u0443\u0434\u0443\u0442\u044C
    \u043C\u0430\u0442\u0438 \u0437\u043D\u0438\u0436\u0435\u043D\u0435 \u0437\u0434\u043E\u0440\u043E\u0432'\u0454."
  - '- Captain, scientists have developed a new prototype called "Drainer" based
    on "Gravity." All enemies within its radius will have reduced health.'
  _updateInEditor: 0
