      m_Calls: []
  m_text: "\"\u0412\u0438\u0441\u043D\u0430\u0436\u0443\u0432\u0430\u0447\" - \u0435\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0438\u0439
    \u043F\u0440\u043E\u0442\u0438 \u0432\u043E\u0440\u043E\u0433\u0456\u0432, \u0449\u043E
    \u043C\u0430\u044E\u0442\u044C \u0431\u0430\u0433\u0430\u0442\u043E \u0437\u0434\u043E\u0440\u043E\u0432'\u044F. 
    \r\n\r\n\u0420\u043E\u0437\u043A\u0440\u0438\u0432\u0430\u0454 \u0441\u0432\u0456\u0439
    \u043F\u043E\u0442\u0435\u043D\u0446\u0456\u0430\u043B \u043A\u043E\u043B\u0438
    \u0441\u0442\u043E\u0457\u0442\u044C \u043D\u0430\u043F\u0440\u043E\u0442\u0438
    \"\u041A\u0440\u0435\u0434\u0438\u0442\u043E\u0440\u0430\" \u0437 \u0434\u0435\u043A\u0456\u043B\u044C\u043A\u043E\u043C\u0430
    \"\u0412\u0438\u0431\u0443\u0445\u043E\u0432\u0438\u043C\u0438 \u043C\u0456\u043D\u0456\u0433\u0430\u043D\u0430\u043C\u0438\"
    \u0442\u0430 \"\u041C\u043E\u0440\u043E\u0437\u043D\u0438\u043C \u043C\u0456\u043D\u0456\u0433\u0430\u043D\u043E\u043C\".
    \u0411\u043E\u043D\u0443\u0441\u043E\u043C \u0431\u0443\u0434\u0435 \u0434\u0435\u043A\u0456\u043B\u044C\u043A\u0430
    \"\u0422\u0432\u0456\u043D \u0448\u0430\u0440\u0434\", \u043F\u0440\u043E\u0442\u0438
    \u043C\u0430\u043B\u043E\u0437\u0430\u0445\u0438\u0449\u0435\u043D\u043D\u0438\u0445
    \u0432\u043E\u0440\u043E\u0433\u0456\u0432, \u0430\u0431\u043E \"\u0422\u0432\u0456\u043D
    \u0433\u0440\u0456\u043C\" \u043F\u0440\u043E\u0442\u0438 \u0431\u0456\u043B\u044C\u0448
    \u0432\u0438\u0442\u0440\u0438\u0432\u0430\u043B\u0438\u0445 \u0432\u043E\u0440\u043E\u0433\u0456\u0432."
